{% extends "base.j2" %}
{% set bg_color = "bg-transparent" %}
{% set rounded = "" %}
{% set shadow = "" %}
{% set padding = "" %}
{% set main_clases = "flex-grow w-full px-0 py-0" %}
{% set flush_content_shell = true %}
{% block content %}
{% set greeting_name = user_full_name or username or "Usuario" %}
<style>
html,body.home,#main-content,#main-content>div{background:transparent!important}#main-content>div{border:0!important;border-radius:0!important;box-shadow:none!important;padding:0!important;margin:0!important}
.ag-dash{width:100%;min-height:calc(100vh - 32px);margin:0;padding:14px 22px;background:transparent;color:#263241;font-family:inherit;font-weight:400;box-sizing:border-box}
.ag-top{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:10px}
.ag-search{position:relative;width:310px}.ag-search input{width:100%;height:36px;border:1px solid #e3e8ed;border-radius:8px;padding:0 12px 0 34px;background:#fff;font-size:12px}.ag-search i{position:absolute;left:12px;top:11px;color:#9aa6b2;font-size:12px}
.ag-actions{display:flex;gap:8px}.ag-btn{height:34px;border:1px solid #e2e7eb;border-radius:8px;background:#fff;padding:0 12px;font-size:11px;font-weight:700}.ag-btn.green{background:#19aa67;border-color:#19aa67;color:#fff}
.ag-welcome{display:flex;align-items:end;justify-content:space-between;margin-bottom:10px}.ag-welcome h1{font-size:20px;font-weight:600;margin:0}.ag-welcome p{font-size:11px;color:#7b8794;margin:3px 0 0}
.ag-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:12px}.ag-card{background:#fff;border:1px solid #e8ecef;border-radius:12px;box-shadow:0 2px 8px rgba(31,45,61,.035);padding:14px;min-width:0}.ag-card h2{font-size:12px;font-weight:600;margin:0;color:#202a38}.ag-card .sub{font-size:10px;color:#8b96a3;margin-top:3px}
.ag-status{grid-column:span 4;height:170px}.ag-overview{grid-column:span 5;height:170px}.ag-kpis{grid-column:span 3;display:grid;gap:12px}.ag-kpi{display:flex;align-items:center;justify-content:space-between;padding:13px 14px}.ag-icon{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:#e9fbf2;color:#13a866}.ag-value{font-size:19px;font-weight:600}.ag-caption{font-size:9px;color:#8a96a3;text-transform:uppercase;letter-spacing:.08em}
.ag-today{display:flex;align-items:center;justify-content:space-between;margin-top:14px}.ag-date{font-size:12px;font-weight:600}.ag-big{font-size:27px;font-weight:600;margin-top:3px}.ag-weather-icon{font-size:54px;color:#f4bd32}.ag-pills{display:flex;gap:6px;margin-top:12px}.ag-pill{padding:5px 8px;border-radius:7px;background:#f3f6f8;font-size:9px;color:#5c6976}
.ag-gauge{position:relative;height:105px;margin-top:0;overflow:hidden}.ag-gauge svg{width:100%;height:125px}.ag-gauge-center{position:absolute;inset:52px 0 auto;text-align:center}.ag-gauge-center strong{font-size:20px}.ag-gauge-center span{display:block;font-size:9px;color:#7e8a96}.ag-legend{display:flex;justify-content:center;gap:12px;font-size:9px;color:#6d7883}.ag-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:4px}
.ag-chart{grid-column:span 7;height:225px}.ag-chart-head{display:flex;align-items:center;justify-content:space-between}.ag-chart-body{height:168px;margin-top:6px}
.ag-field{grid-column:span 5;height:225px;position:relative;overflow:hidden;background:linear-gradient(150deg,#8fc95d 0%,#d8c44b 45%,#4d9d43 100%);color:#fff}.ag-field:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(105deg,transparent 0 18px,rgba(255,255,255,.08) 19px 21px)}.ag-field-content{position:relative;display:flex;height:100%;flex-direction:column;justify-content:space-between}.ag-field h2{color:#fff;font-size:15px}.ag-field-panel{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;background:rgba(255,255,255,.92);border-radius:10px;padding:9px;color:#27313d}.ag-field-panel strong{display:block;font-size:12px}.ag-field-panel span{font-size:8px;color:#7e8994}
.ag-table{grid-column:span 7;height:165px;overflow:hidden}.ag-summary{grid-column:span 5;height:165px;overflow:hidden}.ag-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px solid #edf0f2}.ag-row:last-child{border:0}.ag-row-title{font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ag-row-meta{font-size:9px;color:#8a96a3;margin-top:2px}.ag-row-date{font-size:9px;color:#8a96a3;white-space:nowrap}.ag-link{font-size:9px;font-weight:700;color:#0aa362;text-decoration:none}
.ag-empty{padding:28px;text-align:center;color:#9aa5b1;font-size:11px}
.ag-dash h1,.ag-dash h2,.ag-dash h3,.ag-dash strong,.ag-dash .ag-row-title{font-weight:600}.ag-dash .font-bold,.ag-dash .font-extrabold{font-weight:600!important}@media(min-width:1001px){body{overflow:hidden}main{overflow:hidden!important}}@media(max-width:1000px){.ag-status,.ag-overview,.ag-kpis,.ag-chart,.ag-field,.ag-table,.ag-summary{grid-column:span 12}.ag-kpis{grid-template-columns:1fr 1fr}.ag-field{height:240px}}
@media(max-width:640px){.ag-dash{padding:12px}.ag-top,.ag-welcome{align-items:stretch;flex-direction:column}.ag-search{width:100%}.ag-actions{overflow:auto}.ag-kpis{grid-template-columns:1fr}.ag-grid{gap:9px}}
/* Reference-inspired dashboard skin */
.ag-card{box-sizing:border-box}.ag-overview{overflow:hidden}.ag-overview .ag-gauge{height:82px}.ag-overview .ag-gauge svg{height:100px}.ag-overview .ag-gauge-center{inset:45px 0 auto}.ag-field-wide,.ag-summary-wide{grid-column:span 12}.ag-summary-wide{height:auto;min-height:120px}

