@media(max-width:1000px){.ag-system-bar{grid-template-columns:1fr 1fr}.ag-status,.ag-overview,.ag-kpis,.ag-chart,.ag-field,.ag-table,.ag-summary{grid-column:span 12}.ag-status,.ag-overview,.ag-kpis{height:auto;min-height:158px}}
@media(max-width:640px){.ag-system-item{padding:7px 8px}.ag-system-item span{display:none}}
.ag-analytics{grid-column:span 8;display:grid;grid-template-columns:1fr 1fr;gap:12px}.ag-data-card{height:205px;padding:13px 14px;box-sizing:border-box}.ag-data-chart{height:148px;margin-top:6px}.ag-data-card h2{font-size:11px}.ag-data-card .sub{font-size:8px}.ag-field{height:422px}.ag-field-content{height:100%}@media(max-width:1000px){.ag-analytics{grid-column:span 12}.ag-field{height:240px}}@media(max-width:640px){.ag-analytics{grid-template-columns:1fr}.ag-data-card{height:210px}}/* Compact analytics layout */
.ag-analytics{grid-column:span 12!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:12px}.ag-data-card{height:178px!important;padding:12px!important}.ag-data-chart{height:122px!important;margin-top:4px}.ag-field{grid-column:span 4!important;height:165px!important}.ag-summary,.ag-summary-wide{grid-column:span 8!important;height:165px!important}.ag-field-panel{margin-top:auto}@media(max-width:1200px){.ag-analytics{grid-template-columns:repeat(2,minmax(0,1fr))!important}}@media(max-width:1000px){.ag-field,.ag-summary,.ag-summary-wide{grid-column:span 12!important}}@media(max-width:640px){.ag-analytics{grid-template-columns:1fr!important}}/* Final spacing and overflow containment */
.ag-grid{row-gap:14px}.ag-status,.ag-overview,.ag-kpis{height:172px!important}.ag-status,.ag-overview,.ag-kpi{overflow:hidden}.ag-kpis{grid-template-rows:1fr 1fr}.ag-kpi{min-height:0;padding:10px 12px!important}.ag-kpi .ag-value{font-size:17px}.ag-kpi .sub{margin-top:1px}.ag-overview .ag-gauge{height:92px}.ag-overview .ag-gauge svg{height:104px}.ag-overview .ag-gauge-center{inset:48px 0 auto}.ag-analytics{gap:12px;align-items:stretch}.ag-data-card{height:190px!important;overflow:hidden!important}.ag-data-chart{position:relative;height:116px!important;max-height:116px!important;margin-top:5px;overflow:hidden}.ag-data-chart canvas{display:block!important;width:100%!important;height:116px!important;max-height:116px!important}.ag-field,.ag-summary,.ag-summary-wide{height:172px!important;overflow:hidden!important}.ag-summary .ag-row{padding:5px 0}@media(max-width:1000px){.ag-status,.ag-overview,.ag-kpis{height:auto!important;min-height:172px}.ag-data-card{height:195px!important}}/* Taller analytic cards for readable axes and legends */
.ag-data-card{height:230px!important}.ag-data-chart{height:154px!important;max-height:154px!important}.ag-data-chart canvas{height:154px!important;max-height:154px!important}@media(max-width:1000px){.ag-data-card{height:230px!important}}@media(max-width:640px){.ag-data-card{height:240px!important}.ag-data-chart,.ag-data-chart canvas{height:164px!important;max-height:164px!important}}/* Final canvas height and neutral page background */
html,body.home,#main-content,#main-content>div{background:#fff!important}.ag-dash{background:#fff!important}.ag-data-card{height:255px!important}.ag-data-chart{height:178px!important;max-height:178px!important}.ag-data-chart canvas{height:178px!important;max-height:178px!important}@media(max-width:1000px){.ag-data-card{height:255px!important}}@media(max-width:640px){.ag-data-card{height:265px!important}.ag-data-chart,.ag-data-chart canvas{height:188px!important;max-height:188px!important}}/* Lift top-card content so captions remain visible */
.ag-status{padding:12px 14px!important}.ag-status .ag-today{margin-top:7px}.ag-status .ag-weather-icon{font-size:46px}.ag-status .ag-pills{margin-top:6px}.ag-status .ag-pill{padding:4px 7px}.ag-overview{padding:12px 14px!important}.ag-overview .ag-gauge{height:96px;margin-top:-12px}.ag-overview .ag-gauge svg{height:102px}.ag-overview .ag-gauge-center{inset:43px 0 auto}.ag-overview .ag-legend{position:relative;top:-8px}/* Spacious top metric row */
.ag-status,.ag-overview,.ag-kpis{height:205px!important}.ag-overview{padding:14px!important}.ag-overview .ag-gauge{height:125px;margin-top:-2px}.ag-overview .ag-gauge svg{height:125px}.ag-overview .ag-gauge-center{inset:58px 0 auto}.ag-overview .ag-legend{top:-2px}.ag-status{padding:14px!important}.ag-status .ag-today{margin-top:13px}.ag-status .ag-pills{margin-top:11px}.ag-status .ag-weather-icon{font-size:52px}.ag-kpi{padding:13px 14px!important}.ag-kpi .ag-value{font-size:19px}@media(max-width:1000px){.ag-status,.ag-overview,.ag-kpis{height:auto!important;min-height:190px}}</style>
<div class="ag-dash">
  <div class="ag-system-bar" aria-label="Resumen de la plataforma">
    <div class="ag-system-item"><i class="fas fa-leaf"></i><div><strong>{{ kpis.farms_active }} fincas activas</strong><span>Conectadas a la plataforma</span></div></div>
    <div class="ag-system-item"><i class="fas fa-check-circle"></i><div><strong>{{ operations_dashboard.completed }} completadas</strong><span>Operaciones registradas</span></div></div>
    <div class="ag-system-item"><i class="fas fa-clock"></i><div><strong>{{ operations_dashboard.pending }} pendientes</strong><span>Por gestionar</span></div></div>
    <div class="ag-system-item"><i class="fas fa-satellite-dish"></i><div><strong>{{ operations_dashboard.flight_hours }} h de vuelo</strong><span>Tiempo acumulado</span></div></div>
  </div>

  <div class="ag-grid">
    <section class="ag-card ag-status">
      <div class="flex items-center justify-between"><h2>Hectáreas trabajadas</h2><span class="ag-pill"><i class="fas fa-circle text-emerald-500 mr-1"></i>Activo</span></div>
      <div class="ag-today"><div><div class="ag-date">{{ hectares_chart.current_month }}</div><div class="ag-big">{{ "%.1f"|format(operations_dashboard.month_hectares) }} ha</div><div class="sub">Hectáreas trabajadas</div></div><i class="fas fa-cloud-sun ag-weather-icon"></i></div>
      <div class="ag-pills"><span class="ag-pill">{{ operations_dashboard.flight_hours }} h de vuelo</span><span class="ag-pill">{{ operations_dashboard.completed }} completadas</span><span class="ag-pill">{{ operations_dashboard.pending }} pendientes</span></div>
    </section>

    <section class="ag-card ag-overview">
      <div class="flex items-center justify-between"><div><h2>Producción acumulada</h2><p class="sub">Avance mensual de hectáreas</p></div><span class="ag-pill">{{ hectares_chart.current_month }}</span></div>
      <div class="ag-gauge"><svg viewBox="0 0 240 125"><path d="M25 108 A95 95 0 0 1 215 108" fill="none" stroke="#edf1f2" stroke-width="21" stroke-linecap="round"/><path d="M25 108 A95 95 0 0 1 215 108" fill="none" stroke="#16b86f" stroke-width="21" stroke-linecap="round" stroke-dasharray="210 300"/><path d="M25 108 A95 95 0 0 1 215 108" fill="none" stroke="#8bd542" stroke-width="21" stroke-linecap="round" stroke-dasharray="75 300" stroke-dashoffset="-210"/></svg><div class="ag-gauge-center"><strong>{{ "%.1f"|format(operations_dashboard.total_hectares) }}</strong><span>hectáreas voladas en total</span></div></div>
      <div class="ag-legend"><span><i class="ag-dot bg-emerald-500"></i>{{ operations_dashboard.month_hectares }} ha este mes</span><span><i class="ag-dot bg-lime-400"></i>{{ operations_dashboard.previous_month_hectares }} ha mes anterior</span></div>
    </section>

    <div class="ag-kpis">
      <article class="ag-card ag-kpi"><div><div class="ag-caption">Operaciones completadas</div><div class="ag-value">{{ operations_dashboard.completed }}</div><div class="sub">{{ operations_dashboard.total_hectares }} ha voladas</div></div><span class="ag-icon"><i class="fas fa-seedling"></i></span></article>
      <article class="ag-card ag-kpi"><div><div class="ag-caption">Horas de vuelo</div><div class="ag-value">{{ operations_dashboard.flight_hours }}</div><div class="sub">Acumuladas</div></div><span class="ag-icon" style="background:#f2ecff;color:#8458dc"><i class="fas fa-chart-line"></i></span></article>
    </div>

    <section class="ag-analytics">
      <article class="ag-card ag-data-card"><div class="ag-chart-head"><div><h2>Hectáreas voladas por mes</h2><p class="sub">Histórico de los últimos 12 meses</p></div><span class="ag-pill">ha</span></div><div class="ag-data-chart"><canvas id="monthlyHectaresChart"></canvas></div></article>
      <article class="ag-card ag-data-card"><div class="ag-chart-head"><div><h2>Horas de vuelo por piloto</h2><p class="sub">Datos registrados en bitácora</p></div><span class="ag-pill">horas</span></div><div class="ag-data-chart"><canvas id="pilotHoursChart"></canvas></div></article>
      <article class="ag-card ag-data-card"><div class="ag-chart-head"><div><h2>Comparativo diario</h2><p class="sub">Mes actual frente al anterior</p></div></div><div class="ag-data-chart"><canvas id="dailyHectaresChart"></canvas></div></article>
      <article class="ag-card ag-data-card"><div class="ag-chart-head"><div><h2>Estado de operaciones</h2><p class="sub">Completadas y pendientes</p></div></div><div class="ag-data-chart"><canvas id="operationsStatusChart"></canvas></div></article>
    </section>
<section class="ag-card ag-field">
      <div class="ag-field-content"><div><span class="text-[9px] uppercase tracking-widest text-white/80">Vista general</span><h2 class="mt-1">Tu operación bajo control</h2></div><div class="ag-field-panel"><div><span>Fincas</span><strong>{{ kpis.farms_active }}</strong></div><div><span>Operaciones</span><strong>{{ operations_dashboard.completed }}</strong></div><div><span>Facturado</span><strong>$ {{ "{:,.0f}".format(operations_dashboard.invoiced_total) }}</strong></div></div></div>
    </section>

    {% if operations_dashboard.upcoming %}
    <section class="ag-card ag-table dashboard-filterable">
      <div class="flex items-center justify-between"><div><h2>Próximas operaciones</h2><p class="sub">Agenda operativa real</p></div><a class="ag-link" href="{{ url_for('core.operational_calendar') }}">Ver todo <i class="fas fa-arrow-right ml-1"></i></a></div>
      {% for item in operations_dashboard.upcoming %}<div class="ag-row" data-search="{{ item.title }} {{ item.farm_name }} {{ item.pilot_name }}"><div><div class="ag-row-title">{{ item.title }}</div><div class="ag-row-meta">{{ item.farm_name }} · {{ item.pilot_name }}</div></div><span class="ag-row-date">{{ item.date }}</span></div>{% endfor %}
    </section>
    {% endif %}

    {% if recent_image_analyses %}<section class="ag-card ag-summary dashboard-filterable{% if not operations_dashboard.upcoming %} ag-summary-wide{% endif %}">
      <div class="flex items-center justify-between"><div><h2>Últimos análisis de imagen</h2><p class="sub">Ortofotos procesadas</p></div><a class="ag-link" href="{{ url_for('agrovista.hello') }}">Ver análisis</a></div>
      {% for item in recent_image_analyses %}<div class="ag-row" data-search="{{ item.filename }} {{ item.dimensions }}"><div><div class="ag-row-title"><i class="fas fa-image mr-2 text-sky-500"></i>{{ item.filename }}</div><div class="ag-row-meta">{{ item.dimensions }} px</div></div><span class="ag-row-date">{{ item.date }}</span></div>{% endfor %}
    </section>{% endif %}
  </div>
</div>
{% endblock %}
{% block extra_js %}
{{ super() }}
<script src="/js/chart.js"></script>
<script>
document.addEventListener("DOMContentLoaded",function(){
 const hectares={{ hectares_chart|tojson }},operations={{ operations_dashboard|tojson }};
 const historyLabels=Array.isArray(operations.history_labels)?operations.history_labels:[],historyValues=Array.isArray(operations.history_values)?operations.history_values:[],pilotLabels=Array.isArray(operations.pilot_labels)?operations.pilot_labels:[],pilotHours=Array.isArray(operations.pilot_hours)?operations.pilot_hours:[];
 const common={responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{displayColors:false}},scales:{x:{grid:{display:false},ticks:{font:{size:8},maxRotation:0,maxTicksLimit:8}},y:{beginAtZero:true,grid:{color:"#edf2ed"},border:{display:false},ticks:{font:{size:8},maxTicksLimit:5}}}};
 new Chart(document.getElementById("monthlyHectaresChart"),{type:"bar",data:{labels:historyLabels,datasets:[{label:"Hectáreas",data:historyValues,backgroundColor:"#59cf50",borderRadius:3}]},options:common});
 new Chart(document.getElementById("pilotHoursChart"),{type:"bar",data:{labels:pilotLabels.length?pilotLabels:["Sin registros"],datasets:[{label:"Horas",data:pilotHours.length?pilotHours:[0],backgroundColor:"#173b28",borderRadius:3}]},options:{...common,indexAxis:"y",scales:{x:{beginAtZero:true,grid:{color:"#edf2ed"},ticks:{font:{size:8}}},y:{grid:{display:false},ticks:{font:{size:8}}}}}});
 new Chart(document.getElementById("dailyHectaresChart"),{type:"line",data:{labels:hectares.labels,datasets:[{label:hectares.current_month,data:hectares.current_daily,borderColor:"#20ad62",backgroundColor:"rgba(32,173,98,.09)",fill:true,tension:.35,pointRadius:0,borderWidth:2},{label:hectares.previous_month,data:hectares.previous_daily,borderColor:"#c6d1ca",tension:.35,pointRadius:0,borderWidth:1.5}]},options:{...common,plugins:{legend:{display:true,labels:{boxWidth:7,usePointStyle:true,font:{size:8}}},tooltip:{displayColors:true}}}});
 new Chart(document.getElementById("operationsStatusChart"),{type:"doughnut",data:{labels:["Completadas","Pendientes"],datasets:[{data:[operations.completed,operations.pending],backgroundColor:["#59cf50","#dfe8df"],borderWidth:0,hoverOffset:2}]},options:{responsive:true,maintainAspectRatio:false,cutout:"68%",plugins:{legend:{position:"bottom",labels:{boxWidth:8,usePointStyle:true,font:{size:8}}}}}});
});
</script>
{% endblock %}