      });
    }
    if(el.compareLotSelect){ el.compareLotSelect.addEventListener('change', renderCompareAnalysisOptions); }
    if(el.compareAnalysisSelect){ el.compareAnalysisSelect.addEventListener('change', updateComparisonButtonState); }
    if(el.compareObjectiveSelect){ el.compareObjectiveSelect.addEventListener('change', updateComparisonButtonState); }
    if(el.compareLotASelect){ el.compareLotASelect.addEventListener('change', updateComparisonButtonState); }
    if(el.compareLotBSelect){ el.compareLotBSelect.addEventListener('change', updateComparisonButtonState); }
    if(el.goToComparisonBtn){
      el.goToComparisonBtn.addEventListener('click', async () => {
        if(el.goToComparisonBtn.disabled || isGeneratingComparison){
          return;
        }
        const mode = getSelectedCompareMode();
        const compareUrl = el.goToComparisonBtn.dataset.compareUrl;
        if(!compareUrl){
          setCompareHint("No se encontro la ruta para configurar la comparación.", true);
          return;
        }
        isGeneratingComparison = true;
        el.goToComparisonBtn.disabled = true;
        el.goToComparisonBtn.setAttribute("aria-busy", "true");
        el.goToComparisonBtn.textContent = "Preparando comparación...";
        setCompareHint("Preparando comparación...", false);
        try{
          let payload = { mode };
          if(mode === "lot_vs_objective"){
            const lotIdRaw = el.compareLotSelect ? el.compareLotSelect.value : "";
            const objectiveRaw = el.compareObjectiveSelect ? el.compareObjectiveSelect.value : "";
            const objectiveInfo = parseObjectiveValue(objectiveRaw);
            if(!lotIdRaw || !objectiveRaw){
              throw new Error("Selecciona un lote guardado y un objetivo ideal.");
            }
            const lotId = Number(lotIdRaw);
            if(!Number.isFinite(lotId)){
              throw new Error("Selecciona un lote valido para generar el informe.");
            }
            const analysisRaw = el.compareAnalysisSelect ? el.compareAnalysisSelect.value : "";
            const commonId = analysisRaw ? Number(analysisRaw) : getLatestCommonAnalysisId(lotId);
            if(!commonId || !Number.isFinite(Number(commonId))){
              throw new Error("Selecciona el análisis del lote para generar la comparación.");
            }
            payload.lot_id = lotId;
            payload.common_analysis_id = Number(commonId);
            payload.objective = {
              type: objectiveInfo.type,
              id: Number(objectiveInfo.id),
              label: el.compareObjectiveSelect
                ? (el.compareObjectiveSelect.options[el.compareObjectiveSelect.selectedIndex]?.textContent || "").trim()
                : "",
            };
            payload.lot_label = getSelectedLotLabel(lotId);
          }else{
            const lotAId = el.compareLotASelect ? el.compareLotASelect.value : "";
            const lotBId = el.compareLotBSelect ? el.compareLotBSelect.value : "";
            if(!lotAId || !lotBId || lotAId === lotBId){
              throw new Error("Selecciona dos lotes diferentes para comparar.");
            }
            const entryA = getLotEntryById(lotAId);
            const entryB = getLotEntryById(lotBId);
            if(!entryA || !entryB){
              throw new Error("Selecciona los lotes dibujados para comparar.");
            }
            if(!entryB.linkedLotId){
              throw new Error("Guarda el análisis foliar del Lote B antes de generar el informe.");
            }
            const commonId = entryB.linkedCommonAnalysisId || getLatestCommonAnalysisId(entryB.linkedLotId);
            if(!commonId){
              throw new Error("El Lote B no tiene un análisis común registrado.");
            }
            const areaStats = await ensureAreaStatsForEntry(entryA);
            if(!areaStats || !Array.isArray(areaStats.nutrients) || areaStats.nutrients.length === 0){
              throw new Error("Calcula los datos del Lote A antes de generar el informe.");
            }
            const layerA = drawnItems.getLayer(entryA.id);
            const layerB = drawnItems.getLayer(entryB.id);
            payload.lot_a = {
              id: entryA.id,
              name: entryA.name,
              stats: entryA.stats,
              area_stats: cloneAreaStats(areaStats),
              area_ha: layerA ? computeAreaHaForLayer(layerA) : null,
              linked_lot_id: entryA.linkedLotId ? Number(entryA.linkedLotId) : null,
              linked_common_analysis_id: entryA.linkedCommonAnalysisId
                ? Number(entryA.linkedCommonAnalysisId)
                : null,
            };
            payload.lot_b = {
              id: entryB.id,
              name: entryB.name,
              stats: entryB.stats,
              area_stats: cloneAreaStats(entryB.areaStats),
              area_ha: layerB ? computeAreaHaForLayer(layerB) : null,
              linked_lot_id: Number(entryB.linkedLotId),
              linked_common_analysis_id: Number(commonId),
              linked_lot_name: entryB.linkedLotName || "",
            };
          }
          // Build URL query params for reliable navigation (primary method)
          const params = new URLSearchParams();
          params.set("mode", mode);

          if (mode === "lot_vs_objective") {
            params.set("lot_id", String(payload.lot_id));
            params.set("common_analysis_id", String(payload.common_analysis_id));
            params.set("objective_id", String(payload.objective.id));
            params.set("objective_type", payload.objective.type || "crop");
            params.set("objective_label", payload.objective.label || "");
            if (payload.lot_label) params.set("lot_label", payload.lot_label);
          } else {
            params.set("lot_a_id", String(payload.lot_a.id));
            params.set("lot_a_name", payload.lot_a.name || "");
            params.set("lot_a_area_ha", payload.lot_a.area_ha ? String(payload.lot_a.area_ha) : "");
            if (payload.lot_a.linked_lot_id) params.set("lot_a_linked_lot_id", String(payload.lot_a.linked_lot_id));
            if (payload.lot_a.linked_common_analysis_id) params.set("lot_a_linked_common_analysis_id", String(payload.lot_a.linked_common_analysis_id));
            params.set("lot_b_id", String(payload.lot_b.id));
            params.set("lot_b_name", payload.lot_b.name || "");
            params.set("lot_b_area_ha", payload.lot_b.area_ha ? String(payload.lot_b.area_ha) : "");
            params.set("linked_lot_id", String(payload.lot_b.linked_lot_id));
            params.set("linked_common_analysis_id", String(payload.lot_b.linked_common_analysis_id));
            if (payload.lot_b.linked_lot_name) params.set("linked_lot_name", payload.lot_b.linked_lot_name);
            // Stats complejos van solo por sessionStorage como respaldo
            const token = `cmp_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
            sessionStorage.setItem(`agrovista_comparison_${token}`, JSON.stringify(payload));
            params.set("token", token);
          }

          // Keep sessionStorage as backup for complex data (lot_vs_lot area_stats)
          if (mode === "lot_vs_objective") {
            const token = `cmp_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
            sessionStorage.setItem(`agrovista_comparison_${token}`, JSON.stringify(payload));
            params.set("token", token);
          }

          window.location.href = `${compareUrl}?${params.toString()}`;
        }catch(err){
          const message = err?.message || "Error al preparar la comparación.";
          isGeneratingComparison = false;
          el.goToComparisonBtn.textContent = compareButtonLabel || "Ver comparación nutricional";
          el.goToComparisonBtn.removeAttribute("aria-busy");
          updateComparisonButtonState();
          setCompareHint(message, true);
        }
      });
    }
