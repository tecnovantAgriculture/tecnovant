    function polygonInactiveStyle(layer){
      const entry = ensureLotEntry(layer);
      const color = layer?._inactivePolygonColor
        || polygonInactiveColors[(entry?.colorIndex || 0) % polygonInactiveColors.length];
      if(layer){ layer._inactivePolygonColor = color; }
      return { color, fillColor: color, weight: 2, opacity: 0.82, fillOpacity: 0.2 };
    }

