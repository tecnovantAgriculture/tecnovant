    function computeAreaHaForLayer(layer){
      if(!layer){
        return null;
      }
      const verts = getRasterVertices(layer) || extractVertices(layer);
      if(!Array.isArray(verts) || verts.length < 3){
        return null;
      }
      if(mppX == null){
        return null;
      }
      const _mppY = (mppY != null) ? mppY : mppX;
      const px2 = polygonAreaVerticesPx2(verts);
      const m2 = px2 * mppX * _mppY;
      const ha = m2 / 10000;
      return Number.isFinite(ha) ? ha : null;
    }

    function updateLotAreaInput(force = false){
      if(!el.analysisLotAreaInput){
        return;
      }
      if(!force && el.analysisLotAreaInput.dataset.manual === "1" && el.analysisLotAreaInput.value){
        return;
      }
      const layer = activeLayerId !== null ? drawnItems.getLayer(activeLayerId) : null;
      if(!layer){
        return;
      }
      const ha = computeAreaHaForLayer(layer);
      if(!Number.isFinite(ha) || ha <= 0){
        return;
      }
      el.analysisLotAreaInput.value = ha.toFixed(2);
    }

    function getSelectedCompareMode(){
      if(!el.compareModeInputs){
        return "lot_vs_objective";
      }
      const input = Array.from(el.compareModeInputs).find(node => node.checked);
      return input ? input.value : "lot_vs_objective";
    }

    function updateComparisonButtonState(){
      if(!el.goToComparisonBtn){
        return;
      }
      if(isGeneratingComparison){
        el.goToComparisonBtn.disabled = true;
        return;
      }
      const mode = getSelectedCompareMode();
      let ready = false;
      if(mode === "lot_vs_objective"){
        const lot = el.compareLotSelect ? el.compareLotSelect.value : "";
        const objective = el.compareObjectiveSelect ? el.compareObjectiveSelect.value : "";
        const analysisOk = !el.compareAnalysisSelect || !!el.compareAnalysisSelect.value;
        ready = !!(lot && objective && analysisOk);
      }else{
        const lotA = el.compareLotASelect ? el.compareLotASelect.value : "";
        const lotB = el.compareLotBSelect ? el.compareLotBSelect.value : "";
        const entryB = getLotEntryById(lotB);
        const hasLinkedLot = entryB && Number.isFinite(Number(entryB.linkedLotId));
        const hasCommon = entryB && (entryB.linkedCommonAnalysisId || getLatestCommonAnalysisId(entryB.linkedLotId));
        ready = !!(lotA && lotB && lotA !== lotB && hasLinkedLot && hasCommon);
      }
      el.goToComparisonBtn.disabled = !ready;
      if(ready){
        setCompareHint("Comparación lista para revisar los resultados nutricionales.");
        return;
      }
      if(mode === "lot_vs_lot"){
        const lotA = el.compareLotASelect ? el.compareLotASelect.value : "";
        const lotB = el.compareLotBSelect ? el.compareLotBSelect.value : "";
        if(!lotA || !lotB){
          setCompareHint("Selecciona los dos lotes dibujados para generar la comparación.");
          return;
        }
        if(lotA === lotB){
          setCompareHint("Selecciona dos lotes diferentes.", true);
          return;
        }
        const entryB = getLotEntryById(lotB);
        if(!entryB || !entryB.linkedLotId){
          setCompareHint("Guarda el análisis foliar del Lote B antes de generar el informe.", true);
          return;
        }
        if(!entryB.linkedCommonAnalysisId && !getLatestCommonAnalysisId(entryB.linkedLotId)){
          setCompareHint("El Lote B no tiene un análisis común registrado.", true);
          return;
        }
        const entryA = getLotEntryById(lotA);
        if(entryA && (!entryA.areaStats || !Array.isArray(entryA.areaStats.nutrients) || entryA.areaStats.nutrients.length === 0)){
          setCompareHint("Haz clic en el Lote A para calcular sus datos antes de comparar.");
          return;
        }
        setCompareHint("Selecciona ambos lotes para comparar y generar el informe.");
        return;
      }
      const lotValue = el.compareLotSelect ? el.compareLotSelect.value : "";
      if(lotValue && el.compareAnalysisSelect && el.compareAnalysisSelect.disabled){
        setCompareHint("El lote seleccionado no tiene análisis foliares registrados.", true);
        return;
      }
      if(lotValue && el.compareAnalysisSelect && !el.compareAnalysisSelect.value){
        setCompareHint("Selecciona el análisis del lote que quieres comparar.");
        return;
      }
      const objectiveValue = el.compareObjectiveSelect ? el.compareObjectiveSelect.value : "";
      if(objectiveValue || lotValue){
        setCompareHint("Selecciona el lote, su análisis y el objetivo ideal para generar la comparación.");
        return;
      }
      setCompareHint("Cuando tengas al menos un lote con análisis guardado podrás lanzar la comparación y ver la tabla de Ley de Mínimos.");
    }

    async function ensureAreaStatsForEntry(entry){
      if(!entry){
        return null;
      }
      if(entry.areaStats && Array.isArray(entry.areaStats.nutrients) && entry.areaStats.nutrients.length){
        return entry.areaStats;
      }
      const layer = drawnItems.getLayer(entry.id);
      if(!layer){
        return null;
      }
      await updateStatsForLayer(layer);
      return entry.areaStats || null;
    }

    window.getSavedPolygonMineralRows = async function(){
      const farmId = Number(window.currentFarmId);
      if(!Number.isFinite(farmId) || farmId <= 0){ return []; }
      try{
        const response = await fetch('/api/agrovista/lot-asset-calculations?farm_id=' + encodeURIComponent(farmId), {credentials:'include'});
        const payload = await response.json().catch(() => ({items:[]}));
        if(!response.ok){ throw new Error(payload.description || payload.message || 'No se pudo cargar el historial'); }
        const items = payload.items || [];
        for(const item of items){
          if(item.calculation_data){ continue; }
          try{
            const geometry = typeof item.geometry === 'string' ? JSON.parse(item.geometry) : item.geometry;
            const ring = geometry && geometry.type === 'Polygon' && Array.isArray(geometry.coordinates) ? geometry.coordinates[0] : null;
            const previewWidth = Number(item.preview_width);
            const previewHeight = Number(item.preview_height);
            const widthFull = Number(item.width_full) || previewWidth;
            const heightFull = Number(item.height_full) || previewHeight;
            if(!ring || ring.length < 3 || !previewWidth || !previewHeight || !item.media_asset_id){ continue; }
            const scaleX = widthFull / previewWidth;
            const scaleY = heightFull / previewHeight;
            const vertices = ring.map(coord => [Number(coord[0]) * scaleX, (previewHeight - Number(coord[1])) * scaleY]);
            const calcResponse = await fetch(ENDPOINTS.protein, {
              method: 'POST',
              credentials: 'include',
              headers: {'Content-Type':'application/json', 'X-CSRF-TOKEN':getCsrfToken() || ''},
              body: JSON.stringify({
                id: item.asset_uuid,
                media_asset_id: item.media_asset_id,
                source: 'media',
                visible_method: 'combined',
                width_preview: previewWidth,
                height_preview: previewHeight,
                width_full: widthFull,
                height_full: heightFull,
                scale_x: scaleX,
                scale_y: scaleY,
                coords_full_res: true,
                vertices: vertices,
              }),
            });
            const stats = await calcResponse.json().catch(() => ({}));
            if(!calcResponse.ok){ throw new Error(stats.description || 'No se pudo calcular la ortofoto'); }
            stats.orthophoto_date = stats.orthophoto_date || getOrthophotoDateLabel({original_name:item.orthophoto_name});
            stats.orthophoto_name = stats.orthophoto_name || item.orthophoto_name || '';
            const saveResponse = await fetch('/api/agrovista/lot-asset-geometries/calculation', {
              method: 'POST',
              credentials: 'include',
              headers: {'Content-Type':'application/json', 'X-CSRF-TOKEN':getCsrfToken() || ''},
              body: JSON.stringify({lot_id:item.lot_id, media_asset_id:item.media_asset_id, calculation_data:stats}),
            });
            if(!saveResponse.ok){ throw new Error('No se pudo guardar el análisis calculado'); }
            item.calculation_data = stats;
          }catch(calculationError){
            console.warn('No se pudo completar un análisis histórico de ortofoto', calculationError, item);
          }
        }
        return items.map(item => {
          const stats = item.calculation_data || {};
          const nutrientsInfo = {};
          const row = {
            id: 'polygon-' + String(item.id),
            is_polygon_calculation: true,
            media_asset_id: item.media_asset_id,
            orthophoto_name: item.orthophoto_name || '',
            common_analysis_date: stats.orthophoto_date || getOrthophotoDateLabel({original_name:item.orthophoto_name}),
            farm_id: item.farm_id,
            farm_name: getFarmNameById(item.farm_id) || 'Finca',
            lot_id: item.lot_id,
            lot_name: item.lot_name || ('Lote ' + item.lot_id),
            protein: stats.protein != null ? stats.protein : stats.protein_average,
            yield_estimate: stats.bromatologia && (stats.bromatologia.aforo_ua_ha || stats.bromatologia.aforo),
          };
          (Array.isArray(stats.nutrients) ? stats.nutrients : []).forEach(nutrient => {
            const nutrientId = Number(nutrient && nutrient.nutrient_id);
            const value = Number(nutrient && nutrient.target_value);
            if(!Number.isFinite(nutrientId) || !Number.isFinite(value)){ return; }
            row['nutrient_' + nutrientId] = value;
            nutrientsInfo[String(nutrientId)] = {
              name: nutrient.nutrient_name || nutrient.nutrient_symbol || 'Nutriente',
              symbol: nutrient.nutrient_symbol || nutrient.nutrient_name || '',
              unit: nutrient.nutrient_unit || '',
            };
          });
          row.nutrients_info = nutrientsInfo;
          return row;
        }).filter(row => Object.keys(row.nutrients_info).length);
      }catch(error){
        console.warn('No se pudo cargar el historial de cálculos por ortofoto', error);
        return [];
      }
    };
