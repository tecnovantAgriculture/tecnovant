          saveDraftPolygons();
          window.updateLotReferenceSaveState?.();
          setStatus('Cambios del poligono guardados.');
        }else{
          if(editingLayerId !== null){ drawnItems.getLayer(editingLayerId)?.editing?.disable(); }
          editingLayerId = activeLayerId;
          undoEditLayerId = activeLayerId;
          undoEditLatLngs = clonePolygonLatLngs(layer.getLatLngs());
          layer.editing.enable();
          setStatus('Mueve los vertices y pulsa Guardar cambios.');
        }
        updatePolygonActionButtons();
      });
