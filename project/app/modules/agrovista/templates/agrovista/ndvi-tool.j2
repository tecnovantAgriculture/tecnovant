    if(el.deletePolygonBtn){
      el.deletePolygonBtn.addEventListener('click', async () => {
        const layer = activeLayerId !== null ? drawnItems.getLayer(activeLayerId) : null;
        if(!layer){ return; }
        const entry = lotState.get(activeLayerId);
        const linkedLotId = window.getLinkedLotIdForPolygon?.(layer) || null;
        const result = window.Swal ? await Swal.fire({
          icon: 'warning', title: 'Eliminar poligono',
          text: linkedLotId
            ? 'Se eliminara del mapa y se desligara permanentemente del lote guardado.'
            : 'Se quitara del mapa y del borrador local.',
          showCancelButton: true, confirmButtonText: 'Si, eliminar',
          cancelButtonText: 'Cancelar', confirmButtonColor: '#e11d48', reverseButtons: true
        }) : { isConfirmed: window.confirm('Eliminar este poligono?') };
