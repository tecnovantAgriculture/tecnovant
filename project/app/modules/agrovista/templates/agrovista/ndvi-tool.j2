        drawnItems.removeLayer(layer);
        lotState.delete(key);
        areaStatsCache.delete(key);
        activeLayerId = null;
        editingLayerId = null;
        if(undoEditLayerId === key){
          undoEditLayerId = null;
          undoEditLatLngs = null;
