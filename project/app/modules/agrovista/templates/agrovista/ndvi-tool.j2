        +'<div class="mb-2 grid grid-cols-4 divide-x overflow-hidden rounded border text-center text-[9px]">'+cards.map((card,index)=>'<div class="'+(index<2?'bg-gray-50':'bg-gray-100')+' px-1 py-1"><span class="block uppercase text-gray-500">'+card[0]+'</span><strong class="text-xs">'+(card[1]==null?'--':Number(card[1]).toFixed(2))+'</strong></div>').join('')+'</div>'
        +'<div class="overflow-x-auto"><table class="w-full min-w-[820px] table-fixed text-[9px]"><thead class="bg-gray-50"><tr><th class="sticky left-0 bg-gray-50 px-1.5 py-1 text-left">Concepto</th>'+items.map(item=>'<th class="px-1 py-1">'+symbols[item._key]+'</th>').join('')+'<th class="px-1 py-1">Total</th></tr></thead><tbody>'
        +row('Objetivo (% / ppm)','objective_raw','bg-indigo-50',null)
        +row('Objetivo (kg/ha)','objective_kg','bg-indigo-50',sum('objective_kg'))
        +row('Actual (% / ppm)','actual_raw','bg-sky-50',null)
        +row('Actual (kg/ha)','actual_kg','bg-sky-50',sum('actual_kg'))
        +row('Diferencia (kg/ha)','difference_kg','bg-red-50 text-red-600',sum('difference_kg'))
        +row('Grado formula (%)','grade_pct','bg-yellow-50',sum('grade_pct'),'grade')
        +row('Nano (kg/ha)','nano_kg','bg-emerald-50 text-emerald-800',balance.total_nano_kg_ha,'nano')
        +'</tbody></table></div></div>';
    }
    function bindCompactBalance(){
      const comparisonTables=comparisonContent.querySelectorAll('table');
      const balanceTableNode=comparisonTables[comparisonTables.length-1];
      const totalRows=balanceTableNode?balanceTableNode.querySelectorAll('tbody tr'):[];
      [1,3,4,6].forEach(index=>{
        const cell=totalRows[index]&&totalRows[index].lastElementChild;
        if(cell&&cell.textContent.trim()!=='--'){cell.textContent=cell.textContent.trim()+' kg/ha';}
      });
      const gradeCell=totalRows[5]&&totalRows[5].lastElementChild;
