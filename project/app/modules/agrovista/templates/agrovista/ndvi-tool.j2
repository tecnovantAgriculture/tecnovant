          comparisonContent.querySelectorAll('[data-comparison-row]').forEach(row=>row.addEventListener('click',async()=>{selected=compared.find(entry=>String(entry.id).replace(/[^a-zA-Z0-9_-]/g,'')===row.dataset.comparisonRow)||selected;await render();}));
          const comparisonHeading=comparisonContent.querySelector('h2');
