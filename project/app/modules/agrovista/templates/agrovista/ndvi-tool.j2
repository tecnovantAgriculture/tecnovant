        if(!layer || !undoEditLatLngs){ return; }
        layer.editing?.disable();
        layer.setLatLngs(clonePolygonLatLngs(undoEditLatLngs));
        layer.redraw?.();
        editingLayerId = null;
        const key = getLayerKey(layer);
        if(key !== null){ areaStatsCache.delete(key); }
        undoEditLayerId = null;
        undoEditLatLngs = null;
        setActiveLayer(layer);
        updateAreaForLayer(layer);
        saveDraftPolygons();
        window.updateLotReferenceSaveState?.();
