        el.analysisLotAreaInput.dataset.manual = "0";
      }
      renderFarmOptions(window.currentFarmId);
      renderLotOptions(window.currentFarmId);

      // Mostrar coordenadas del polígono activo
      const _drawnLayers = window.drawnItems ? window.drawnItems.getLayers() : [];
