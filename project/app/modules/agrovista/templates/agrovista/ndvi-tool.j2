          document.getElementById("map-container")?.appendChild(drawingTools);
          drawingTools.className = "absolute z-30 flex flex-wrap items-center gap-2";
          drawingTools.style.cssText = "left:12px;top:12px;right:470px;";
        }else if(drawingToolsHome){
          if(drawingToolsNextSibling && drawingToolsNextSibling.parentNode === drawingToolsHome){
            drawingToolsHome.insertBefore(drawingTools, drawingToolsNextSibling);
          }else{
            drawingToolsHome.appendChild(drawingTools);
