    // ===== Lot Reference (Geometry) Loader =====
    (function() {
      const farmSelector = document.getElementById('referenceFarmSelect');
      const lotSelector = document.getElementById('referenceLotsSelect');
      const lotStatus = document.getElementById('lotPolygonStatus');
      const savePolygonBtn = document.getElementById('savePolygonToLotBtn');
      const contextFarmEl = document.getElementById('contextFarm');
      const importObjectivePanel = document.getElementById('importFarmObjectivePanel');
      const importObjectiveText = document.getElementById('importFarmObjectiveText');
      const importObjectiveBtn = document.getElementById('importFarmObjectiveBtn');

      let lotGeometryMap = {};
      let lotObjectiveMap = {};
      let currentLotPolygon = null;
      const farmLotPolygons = new Map();
      let selectedLotId = null;
      let pendingNewPolygon = null;
      let transferredPolygons = [];

      if (!lotSelector) return;

      async function loadReferenceFarms() {
        if (!farmSelector) return;
        farmSelector.disabled = true;
        try {
          const response = await fetch('/api/foliage/farms/', { credentials: 'include' });
          const farms = await response.json().catch(() => []);
          if (!response.ok) throw new Error(farms?.description || farms?.error || 'No se pudieron cargar las fincas');
          farmSelector.innerHTML = '<option value="">-- Seleccionar finca --</option>';
          (Array.isArray(farms) ? farms : []).forEach(function(farm) {
            const option = document.createElement('option');
            option.value = farm.id;
            option.textContent = farm.name || ('Finca ' + farm.id);
            farmSelector.appendChild(option);
          });
          if (window.currentFarmId) farmSelector.value = String(window.currentFarmId);
        } catch (error) {
          farmSelector.innerHTML = '<option value="">-- Error al cargar fincas --</option>';
          lotStatus.textContent = '❌ ' + error.message;
        } finally {
          farmSelector.disabled = false;
        }
      }

      if (farmSelector) {
        farmSelector.addEventListener('change', function() {
          window.currentFarmId = this.value ? Number(this.value) : null;
          if (el.analysisFarmSelect) {
            el.analysisFarmSelect.value = this.value;
            renderLotOptions(this.value);
          }
          loadLotsForCurrentFarm();
        });
      }
      // Cargar lotes cuando se cambia de finca
      function loadLotsForCurrentFarm() {
        // Usar window.currentFarmId como fuente de verdad (establecido por farm picker o analysisFarmSelect)
        const farmId = window.currentFarmId;
        selectedLotId = null;
        pendingNewPolygon = null;
        transferredPolygons = [];
        importObjectivePanel?.classList.add('hidden');
        clearFarmLotPolygons();
        lotGeometryMap = {};
        lotObjectiveMap = {};
        lotSelector.value = '';
        if (!farmId) {
          lotSelector.innerHTML = '<option value="">-- Sin finca seleccionada --</option>';
          lotStatus.textContent = 'Selecciona una finca para ver los lotes disponibles';
          updateSaveButtonState();
          return;
        }

        fetch('/api/foliage/lots/?filter_value=' + farmId, {
          credentials: 'include'
        })
        .then(async r => {
          const body = await r.json().catch(() => ({}));
          if (!r.ok) throw new Error(body?.description || body?.error || body?.message || 'La solicitud no pudo completarse');
          return body;
        })
        .then(async lots => {
          const currentAssetId = Number(imageMeta?.media_asset_id);
          if(currentAssetId > 0){
            const params = new URLSearchParams({
              farm_id: String(farmId),
              media_asset_id: String(currentAssetId),
              preview_width: String(imageMeta?.width_preview || imageWidth),
              preview_height: String(imageMeta?.height_preview || imageHeight),
            });
            const geoResponse = await fetch('/api/agrovista/lot-asset-geometries?' + params.toString(), { credentials: 'include' });
            const geoData = await geoResponse.json().catch(() => ({items: []}));
            if(geoResponse.ok){
              const byLot = new Map((geoData.items || []).map(item => [Number(item.lot_id), item]));
              (lots || []).forEach(lot => {
                const item = byLot.get(Number(lot.id));
                if(!item){ return; }
                lot.is_objective = !!item.is_objective;
                lot.calculation_data = item.calculation_data || null;
                if(item.saved_for_asset){
                  lot.geometry = item.geometry;
                  lot.media_asset_id = currentAssetId;
                }else if(item.transferred){
                  transferredPolygons.push(item);
                  lot.geometry = item.geometry;
                  lot.media_asset_id = currentAssetId;
                }
              });
              if(transferredPolygons.length && importObjectivePanel){
                importObjectiveText.textContent = transferredPolygons.length + ' polígono(s) de esta finca se ubicaron por coordenadas desde otras ortofotos.';
                importObjectiveBtn.textContent = 'Confirmar polígonos en esta ortofoto';
                importObjectivePanel.classList.remove('hidden');
              }
            }
          }
          lotSelector.innerHTML = '<option value="">-- Seleccionar lote --</option>';
          const layersToCalculate = [];
          lotGeometryMap = {};
          lotObjectiveMap = {};
          (lots || []).forEach(function(lot) {
            var opt = document.createElement('option');
            opt.value = lot.id;
            const belongsToCurrentImage = currentAssetId > 0 && Number(lot.media_asset_id) === currentAssetId;
            const hasGeometry = belongsToCurrentImage && lot.geometry && lot.geometry.trim() !== '';
            const icon = hasGeometry ? '📍' : '○';
            const baseLabel = icon + ' ' + lot.name + ' (' + lot.area + ' ha)';
            const isObjective = !!lot.is_objective;
            opt.textContent = (isObjective ? '⭐ OBJETIVO · ' : '') + baseLabel;
            opt.dataset.baseLabel = baseLabel;
            opt.dataset.hasGeometry = hasGeometry ? '1' : '0';
            opt.dataset.isObjective = isObjective ? '1' : '0';
            lotObjectiveMap[lot.id] = isObjective;
            lotSelector.appendChild(opt);
            if (hasGeometry) {
              lotGeometryMap[lot.id] = lot.geometry;
              const loadedLayer = drawLotPolygon(lot.geometry, lot.id, false, lot.name, lot.calculation_data);
              if(loadedLayer){ layersToCalculate.push(loadedLayer); }
            }
          });
          updateSaveButtonState();
          if(layersToCalculate.length){
            setStatus('Calculando automáticamente los polígonos de la finca…');
            for(const layer of layersToCalculate){
              await updateStatsForLayer(layer);
            }
            setStatus(layersToCalculate.length + ' polígonos calculados y disponibles en Foliar.');
          }
        })
        .catch(err => {
          lotStatus.textContent = '❌ Error al cargar lotes: ' + (err.message || '');
          console.error('Error loading lots:', err);
        });
      }

      lotSelector.addEventListener('change', function() {
        selectedLotId = this.value;

        // Si hay un polígono nuevo activo, conservarlo como candidato al
        // seleccionar el lote. Esto evita que el botón quede bloqueado cuando
        // la selección visual y el estado interno se desincronizan.
        if (!pendingNewPolygon && activeLayerId !== null) {
          const activeLayer = drawnItems.getLayer(activeLayerId);
          const activeEntry = lotState.get(activeLayerId);
          if (activeLayer && !activeEntry?.linkedLotId) pendingNewPolygon = activeLayer;
        }

        if (!selectedLotId) {
          lotStatus.textContent = 'Selecciona un lote para visualizar su polígono';
          updateSaveButtonState();
          return;
        }

        if (lotGeometryMap[selectedLotId]) {
          currentLotPolygon = farmLotPolygons.get(Number(selectedLotId)) || null;
          if (currentLotPolygon) {
            setActiveLayer(currentLotPolygon);
            updateStatsForLayer(currentLotPolygon);
            if (currentLotPolygon.getBounds?.().isValid()) map.fitBounds(currentLotPolygon.getBounds(), { padding: [50, 50] });
          }
          lotStatus.innerHTML = '✓ <strong>Polígono del lote cargado</strong><br><span class="text-xs">Mostrado en naranja punteado. Dibuja un nuevo polígono para reemplazarlo.</span>';
        } else {
          currentLotPolygon = null;
          lotStatus.innerHTML = '○ <strong>Este lote no tiene límites definidos aún</strong><br><span class="text-xs">Dibuja un polígono en el mapa para asociarlo a este lote.</span>';
        }
        updateSaveButtonState();
      });

      function drawLotPolygon(geojsonStr, lotId = null, shouldFit = true, lotName = null, savedCalculation = null) {
        try {
          var geoJsonObj = JSON.parse(geojsonStr);
          // Extraer coordenadas del GeoJSON (formato: [lng, lat])
          var coords = [];
          if (geoJsonObj.type === 'Feature' && geoJsonObj.geometry) {
            geoJsonObj = geoJsonObj.geometry;
          }
          if (geoJsonObj.type === 'Polygon' && geoJsonObj.coordinates && geoJsonObj.coordinates[0]) {
            // Convertir [lng, lat] a [lat, lng] para Leaflet
            coords = geoJsonObj.coordinates[0].map(function(c) { return [c[1], c[0]]; });
          } else if (geoJsonObj.type === 'MultiPolygon' && geoJsonObj.coordinates && geoJsonObj.coordinates[0]) {
            coords = geoJsonObj.coordinates[0][0].map(function(c) { return [c[1], c[0]]; });
          }

          if (coords.length < 3) {
            throw new Error('GeoJSON no contiene un polígono válido');
          }

          // Cada lote conserva un color propio; el seleccionado se resalta en azul.
          const lotColorIndex = farmLotPolygons.size % polygonInactiveColors.length;
          const lotColor = polygonInactiveColors[lotColorIndex];
          const layer = L.polygon(coords, {
            color: lotColor,
            fillColor: lotColor,
            weight: 3,
            opacity: 0.9,
            fillOpacity: 0.18,
            dashArray: '5, 5'
          });
          layer._inactivePolygonColor = lotColor;
          drawnItems.addLayer(layer);
          const entry = ensureLotEntry(layer);
          if(entry){ entry.colorIndex = lotColorIndex; }
          if (entry) {
            entry.linkedLotId = lotId ? Number(lotId) : null;
            entry.linkedLotName = lotName || entry.linkedLotName;
            if (lotName) entry.name = lotName;
            if (savedCalculation && typeof savedCalculation === 'object') {
              entry.stats = getPrimaryStatsFromData(savedCalculation);
              entry.areaStats = cloneAreaStats(savedCalculation);
              entry.calculationPersisted = true;
              const key = getLayerKey(layer);
              if (key !== null) areaStatsCache.set(key, savedCalculation);
            }
          }
          wireArea(layer);
          if (lotId) {
            farmLotPolygons.set(Number(lotId), layer);
            layer.on('click', function() {
              currentLotPolygon = layer;
              selectedLotId = String(lotId);
              lotSelector.value = String(lotId);
              updateSaveButtonState();
            });
          }
          if (shouldFit) {
            currentLotPolygon = layer;
            setActiveLayer(layer);
            updateStatsForLayer(layer);
            if (layer.getBounds && layer.getBounds().isValid()) map.fitBounds(layer.getBounds(), { padding: [50, 50] });
          }
          return layer;
        } catch(e) {
          lotStatus.textContent = '❌ Error al cargar polígono: ' + (e.message || '');
          console.error('GeoJSON parse error:', e);
        }
      }

      if(importObjectiveBtn){
        importObjectiveBtn.addEventListener('click', async function(){
          if(!transferredPolygons.length){ return; }
          importObjectiveBtn.disabled = true;
          try{
            await Promise.all(transferredPolygons.map(item => fetch('/api/agrovista/lot-asset-geometries', {
              method:'POST', credentials:'include',
              headers:{'Content-Type':'application/json','X-CSRF-TOKEN':getCsrfToken() || ''},
              body:JSON.stringify({lot_id:item.lot_id, media_asset_id:imageMeta?.media_asset_id, geometry:item.geometry, preview_width:imageMeta?.width_preview || imageWidth, preview_height:imageMeta?.height_preview || imageHeight, is_objective:!!item.is_objective})
            }).then(async response => { if(!response.ok){ const body=await response.json().catch(()=>({})); throw new Error(body.description || 'No se pudo guardar un polígono'); } })));
            for(const item of transferredPolygons){
              const layer = farmLotPolygons.get(Number(item.lot_id));
              if(layer){ await updateStatsForLayer(layer); }
            }
            importObjectivePanel?.classList.add('hidden');
            lotStatus.textContent = transferredPolygons.length + ' polígonos confirmados y calculados en esta ortofoto.';
            if(window.Swal){ await Swal.fire({icon:'success',title:'Polígonos ubicados',text:'Los polígonos de la finca quedaron asociados a esta ortofoto.',confirmButtonText:'Aceptar'}); }
            transferredPolygons = [];
          }catch(error){
            if(window.Swal){ await Swal.fire({icon:'error',title:'No se pudieron confirmar',text:error.message || 'Intenta nuevamente.',confirmButtonText:'Aceptar'}); }
          }finally{ importObjectiveBtn.disabled = false; }
        });
      }

      function clearFarmLotPolygons() {
        farmLotPolygons.forEach(function(layer) {
          const key = getLayerKey(layer);
          drawnItems.removeLayer(layer);
          if (key !== null) { lotState.delete(key); areaStatsCache.delete(key); }
        });
        farmLotPolygons.clear();
        currentLotPolygon = null;
        activeLayerId = null;
        renderLotsList();
        updatePolygonActionButtons();
      }

      function removeLotPolygon() {
        if (currentLotPolygon) {
          // Remover de drawnItems y del mapa
          drawnItems.removeLayer(currentLotPolygon);
          map.removeLayer(currentLotPolygon);
          // Si era el polígono activo, resetear activeLayerId
          const layerKey = getLayerKey(currentLotPolygon);
          if (layerKey !== null && activeLayerId === layerKey) {
            activeLayerId = null;
            setText(el.activeLotName, "Sin lote seleccionado");
          }
          if (selectedLotId) farmLotPolygons.delete(Number(selectedLotId));
          currentLotPolygon = null;
        }
      }

      function getLinkedLotIdForPolygon(layer) {
        if (!layer || layer !== currentLotPolygon || !selectedLotId) return null;
        return Number(selectedLotId);
      }

      async function unlinkPolygonFromLot(layer) {
        const lotId = getLinkedLotIdForPolygon(layer);
        if (!lotId) return true;
        try {
          const params = new URLSearchParams({farm_id:String(window.currentFarmId), media_asset_id:String(imageMeta?.media_asset_id), lot_id:String(lotId)});
          const response = await fetch('/api/agrovista/lot-asset-geometries?' + params.toString(), {
            method: 'DELETE',
            headers: { 'X-CSRF-TOKEN': getCsrfToken() || '' },
            credentials: 'include'
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(body?.description || body?.error || body?.message || 'No se pudo desligar el poligono');

          lotGeometryMap[String(lotId)] = null;
          farmLotPolygons.delete(lotId);
          lotObjectiveMap[String(lotId)] = false;
          const option = Array.from(lotSelector.options).find(item => Number(item.value) === lotId);
          if (option) {
            option.dataset.hasGeometry = '0';
            option.dataset.isObjective = '0';
            option.dataset.baseLabel = (option.dataset.baseLabel || option.textContent).replace(/^📍/, '○');
            option.textContent = option.dataset.baseLabel;
          }
          const storedLot = foliarState.lots.find(item => Number(item?.id) === lotId);
          if (storedLot) {
            storedLot.geometry = null;
            storedLot.media_asset_id = null;
            storedLot.is_objective = false;
          }
          renderLotOptions(window.currentFarmId);
          renderCompareLotOptions();
          currentLotPolygon = null;
          lotStatus.textContent = 'Poligono desligado del lote correctamente.';
          updateSaveButtonState();
          return true;
        } catch (error) {
          if (window.Swal) await Swal.fire({ icon: 'error', title: 'No se pudo eliminar', text: error.message || 'No se pudo desligar el poligono del lote.', confirmButtonText: 'Aceptar' });
          else alert('Error al desligar el poligono: ' + (error.message || ''));
          return false;
        }
      }

      function updateSaveButtonState() {
        if (!savePolygonBtn) return;

        const hasLotSelected = !!selectedLotId;
        const lotHasGeometry = hasLotSelected && lotGeometryMap[selectedLotId];
        const hasPolygonDrawn = !!(
          pendingNewPolygon && window.drawnItems && window.drawnItems.hasLayer(pendingNewPolygon)
        );

        // Resetear clases de color (remover clases de color anteriores)
        savePolygonBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700', 'bg-amber-600', 'bg-emerald-600');

        // Caso 1: No hay lote seleccionado
        if (!hasLotSelected) {
          savePolygonBtn.disabled = false;
          savePolygonBtn.innerHTML = '<i class="fas fa-save mr-2"></i>Guardar polígono en lote';
          savePolygonBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
          savePolygonBtn.title = 'Selecciona un lote primero';
          return;
        }

        // Caso 2: Lote con geometría existente
        if (lotHasGeometry) {
          savePolygonBtn.innerHTML = '<i class="fas fa-exchange-alt mr-2"></i>Actualizar polígono del lote';
          savePolygonBtn.classList.add('bg-amber-600');
          savePolygonBtn.classList.remove('hover:bg-blue-700');
          savePolygonBtn.classList.add('hover:bg-amber-700');
          savePolygonBtn.disabled = false;
          savePolygonBtn.title = hasPolygonDrawn
            ? '⚠️ Esto sobrescribirá la geometría actual. Confirma al hacer click.'
            : '⚠️ Dibuja un polígono primero para actualizar los límites';
          return;
        }

        // Caso 3: Lote sin geometría
        if (hasPolygonDrawn) {
          savePolygonBtn.innerHTML = '<i class="fas fa-plus-circle mr-2"></i>Asociar polígono al lote';
          savePolygonBtn.classList.add('bg-emerald-600');
          savePolygonBtn.classList.remove('hover:bg-blue-700');
          savePolygonBtn.classList.add('hover:bg-emerald-700');
          savePolygonBtn.disabled = false;
          savePolygonBtn.title = '✓ Listo para guardar. Click aquí para asociar el polígono.';
        } else {
          savePolygonBtn.innerHTML = '<i class="fas fa-plus-circle mr-2"></i>Asociar polígono al lote';
          savePolygonBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
          savePolygonBtn.disabled = false;
          savePolygonBtn.title = 'Dibuja un polígono en el mapa primero';
        }
      }

