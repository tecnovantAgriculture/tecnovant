          if(comparisonHeading&&comparisonHeading.parentElement){comparisonHeading.parentElement.classList.add('hidden');}
          comparisonSubtitle.textContent=entries.length+' lotes - '+comparisonEntryMeta(reference).lot+' como objetivo';
          const balance=await getBalance(selected,buildRows(selected.areaStats||{},objective),objective),node=document.getElementById('lotComparisonBalance');
          if(node){node.outerHTML=compactComparisonBalance(balance,selected,objective);bindCompactBalance();return;}
          if(node){node.outerHTML=balanceTable(balance,selected,objective);}
        };
        await render();
      }catch(error){console.error('Error preparando comparación de lotes',error);comparisonContent.innerHTML='<div class="border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">'+escapeHtml(error.message||'No se pudo calcular la comparación.')+'</div>';}
    }
    async function openFlexibleLotComparison(){
      let entries=getComparableLotEntries().slice(0,20);
      if(!comparisonModal||!comparisonContent){return;}
      if(entries.length<2){if(window.Swal){await Swal.fire({icon:'info',title:'Comparacion no disponible',text:'Se necesitan por lo menos dos polígonos calculados, guardados o recién dibujados.',confirmButtonText:'Aceptar'});}return;}
      comparisonContent.innerHTML='<div class="p-8 text-center text-sm text-gray-500"><i class="fas fa-spinner fa-spin mr-2"></i>Preparando comparacion...</div>';
      comparisonModal.classList.remove('hidden');document.body.classList.add('overflow-hidden');
      try{
        for(const entry of entries){const stats=await ensureAreaStatsForEntry(entry);if(stats){entry.areaStats=stats;}}
        entries=entries.filter(entry=>entry.areaStats);
        if(entries.length<2){throw new Error('No fue posible obtener dos analisis para comparar.');}
        let reference=entries.find(isObjectiveEntry)||entries[0];
        let selected=entries.find(entry=>entry!==reference);
        const render=async()=>{
          if(selected===reference){selected=entries.find(entry=>entry!==reference);}
          const objective=comparisonObjective(reference);
          const objectiveRows=entries.map(entry=>comparisonTableRow(entry,entry===reference,false).replace('data-comparison-row','data-objective-row')).join('');
          const activeReference=reference;
          reference=null;
          const foliarEntries=entries.filter(entry=>entry!==reference);
          reference=activeReference;
          const foliarRows=foliarEntries.map(entry=>comparisonTableRow(entry,entry===selected,false)).join('');
          comparisonContent.innerHTML='<div class="space-y-3">'+comparisonTable('Objetivo',objectiveRows,true)+comparisonTable('Foliar',foliarRows,false)+'<section class="rounded-xl border border-gray-200 bg-white p-2 shadow-sm"><h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-emerald-700">Balance</h3><div id="lotComparisonBalance" class="p-6 text-center text-xs text-gray-500"><i class="fas fa-spinner fa-spin mr-2"></i>Calculando balance...</div></section></div>';
          comparisonSubtitle.textContent=entries.length+' lotes - '+comparisonEntryMeta(reference).lot+' como objetivo';
          comparisonContent.querySelectorAll('[data-objective-row]').forEach(row=>row.addEventListener('click',async()=>{
            reference=entries.find(entry=>String(entry.id).replace(/[^a-zA-Z0-9_-]/g,'')===row.dataset.objectiveRow)||reference;
            await render();
          }));
          comparisonContent.querySelectorAll('[data-comparison-row]').forEach(row=>row.addEventListener('click',async()=>{
            selected=foliarEntries.find(entry=>String(entry.id).replace(/[^a-zA-Z0-9_-]/g,'')===row.dataset.comparisonRow)||selected;
            await render();
          }));
          const balance=await getBalance(selected,buildRows(selected.areaStats||{},objective),objective);
          const node=document.getElementById('lotComparisonBalance');
          if(node){node.outerHTML=compactComparisonBalance(balance,selected,objective);bindCompactBalance();}
        };
        await render();
      }catch(error){
        console.error('Error preparando comparacion flexible',error);
        comparisonContent.innerHTML='<div class="border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">'+escapeHtml(error.message||'No se pudo calcular la comparacion.')+'</div>';
      }
    }
    async function openLotComparison(){
      return openFlexibleLotComparison();
      return openLotComparisonTables();
      let entries = getComparableLotEntries().slice(0, 4);
      const objective = getSelectedObjective();
      return openFlexibleLotComparison();
      if(!comparisonModal || !comparisonContent){ return; }
      if(entries.length < 2){
        const message = entries.length === 1
          ? 'Hay un solo lote guardado en esta ortofoto. Guarde otro polígono en un lote diferente para comparar.'
          : 'Todavía no hay dos lotes con polígonos guardados en esta ortofoto.';
        if(window.Swal){
          await Swal.fire({ icon: 'info', title: 'Comparación no disponible', text: message, confirmButtonText: 'Aceptar' });
        }else{
          alert(message);
        }
        return;
      }
      const objectiveLabel = objective && select && select.selectedIndex >= 0
        ? (select.options[select.selectedIndex].textContent || "").trim()
        : "lote objetivo de la finca como referencia";
      comparisonSubtitle.textContent = entries.length + " lotes · " + objectiveLabel;
      comparisonContent.innerHTML = '<div class="flex min-h-[240px] items-center justify-center text-sm text-gray-500"><i class="fas fa-spinner fa-spin mr-2"></i>Calculando comparación...</div>';
      comparisonModal.classList.remove("hidden");
      document.body.classList.add("overflow-hidden");
      comparisonClose && comparisonClose.focus();
      try{
        for(const entry of entries){
          const stats = await ensureAreaStatsForEntry(entry);
          if(stats){ entry.areaStats = stats; }
        }
        entries = entries.filter(entry => entry.areaStats);
        if(entries.length < 2){
          throw new Error("No fue posible calcular los datos de los dos lotes.");
        }
        const balances = objective
          ? await Promise.all(entries.map(entry => getBalance(entry, buildRows(entry.areaStats || {}, objective), objective)))
          : entries.map(() => null);
        const maps = balances.map(balanceEntryMap);
        const nutrientNames = [];
        const nutrientLabels = new Map();
        balances.forEach(balance => {
          (balance && Array.isArray(balance.entries) ? balance.entries : []).forEach(item => {
            const key = normalizeName(item.name);
            if(key && !nutrientLabels.has(key)){
              nutrientNames.push(key);
              nutrientLabels.set(key, item.name);
            }
          });
        });
        const summary = entries.map((entry, index) => {
          const balance = balances[index] || {};
          const balanceRows = Array.isArray(balance.entries) ? balance.entries : [];
          const actualTotal = balanceRows.reduce((sum, item) => sum + (Number(item.actual_kg) || 0), 0);
          const differenceTotal = balanceRows.reduce((sum, item) => sum + (Number(item.difference_kg) || 0), 0);
          return '<article class="border-l-4 border-emerald-600 bg-gray-50 px-4 py-3 dark:bg-gray-800"><h3 class="truncate text-sm font-semibold text-gray-900 dark:text-gray-100">' + escapeHtml(entry.name || ('Lote ' + (index + 1))) + '</h3><dl class="mt-2 grid grid-cols-3 gap-3 text-xs"><div><dt class="text-gray-500">Actual</dt><dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100">' + comparisonMetric(actualTotal, ' kg/ha') + '</dd></div><div><dt class="text-gray-500">Déficit</dt><dd class="mt-1 font-semibold text-red-600">' + comparisonMetric(differenceTotal, ' kg/ha') + '</dd></div><div><dt class="text-gray-500">Nano</dt><dd class="mt-1 font-semibold text-emerald-700">' + comparisonMetric(balance.total_kg_ha, ' kg/ha') + '</dd></div></dl></article>';
        }).join('');
        const header = entries.map(entry => '<th colspan="3" class="border-l border-gray-200 px-3 py-2 text-center text-xs font-semibold text-gray-900 dark:border-gray-700 dark:text-gray-100">' + escapeHtml(entry.name || 'Lote') + '</th>').join('');
        const subheader = entries.map(() => '<th class="border-l border-gray-200 px-2 py-2 text-right text-[11px] font-medium text-gray-500 dark:border-gray-700">Actual</th><th class="px-2 py-2 text-right text-[11px] font-medium text-gray-500">Diferencia</th><th class="px-2 py-2 text-right text-[11px] font-medium text-gray-500">Nano</th>').join('');
        const rows = nutrientNames.map(key => '<tr class="border-t border-gray-100 dark:border-gray-800"><th class="sticky left-0 z-10 bg-white px-3 py-2 text-left text-xs font-semibold text-gray-700 dark:bg-gray-900 dark:text-gray-200">' + escapeHtml(nutrientLabels.get(key)) + '</th>' + maps.map(map => { const item = map.get(key) || {}; return '<td class="border-l border-gray-100 px-2 py-2 text-right text-xs dark:border-gray-800">' + comparisonMetric(item.actual_kg) + '</td><td class="px-2 py-2 text-right text-xs text-red-600">' + comparisonMetric(item.difference_kg) + '</td><td class="px-2 py-2 text-right text-xs font-semibold text-emerald-700">' + comparisonMetric(item.nano_kg) + '</td>'; }).join('') + '</tr>').join('');
        comparisonContent.innerHTML = '';
        const detailPanels = entries.map((entry, index) => {
          const stats = entry.areaStats || {};
          const vars = getVariablesSource(stats);
          const primary = getPrimaryStatsFromData(stats);
          const broma = stats.bromatologia || {};
          const layer = drawnItems ? drawnItems.getLayer(entry.id) : null;
          const areaHa = layer ? computeAreaHaForLayer(layer) : null;
          const fmt = (number, decimals, suffix) => Number.isFinite(Number(number)) ? Number(number).toFixed(decimals) + (suffix || '') : '--';
          const nutrients = (Array.isArray(stats.nutrients) ? stats.nutrients : []).map(item => '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;min-width:0;border:1px solid #e2e8f0;border-radius:7px;background:#f8fafc;padding:6px 8px;"><span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#334155;">' + escapeHtml(item.nutrient_name || item.nutrient_symbol || 'Nutriente') + (item.nutrient_symbol ? ' (' + escapeHtml(item.nutrient_symbol) + ')' : '') + '</span><strong style="flex:none;white-space:nowrap;color:#047857;text-align:right;">' + comparisonMetric(item.target_value, item.nutrient_unit ? ' ' + item.nutrient_unit : '') + '</strong></div>').join('');
          const metric = (label, value, accent) => '<div style="background:#f8fafc;border:1px solid #eef2f7;border-radius:9px;padding:7px 5px;text-align:center;min-width:0;"><span style="display:block;color:#64748b;font-size:10px;line-height:1.1;">' + label + '</span><strong style="display:block;margin-top:3px;color:' + (accent || '#0f172a') + ';font-size:13px;line-height:1.1;">' + value + '</strong></div>';
          const objectiveEntry = isObjectiveEntry(entry);
          const badge = objectiveEntry
            ? '<i class="fas fa-star" aria-hidden="true"></i> OBJETIVO · REFERENCIA'
            : '<i class="fas fa-layer-group" aria-hidden="true"></i> LOTE COMPARADO';
          const analysis = '<div style="padding:12px;">'
            + '<div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;">'
            + metric('NDVI', fmt(primary.ndvi,2), '#047857')
            + metric('VARI', fmt(primary.vari,2), '#047857')
            + metric('NBI', fmt(primary.nbi,2), '#047857')
            + metric('Área', fmt(areaHa,4,' ha'))
            + metric('Proteína', fmt(stats.protein != null ? stats.protein : stats.protein_average,2,'%'), '#7c3aed')
            + metric('Nitrógeno', fmt(stats.nitrogen,2,'%'), '#2563eb') + '</div>'
            + '<div style="display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px;">'
            + '<section style="border:1px solid #e2e8f0;border-radius:9px;padding:8px;background:#fff;font-size:10px;"><h4 style="font-size:11px;font-weight:700;color:#334155;margin:0 0 6px;"><i class="fas fa-seedling" style="margin-right:5px;color:#64748b;" aria-hidden="true"></i>Perfil bromatológico</h4><div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 8px;color:#475569;"><span>FDA <strong>' + fmt(broma.fda_pct,2,'%') + '</strong></span><span>FDN <strong>' + fmt(broma.fdn_pct,2,'%') + '</strong></span><span>Energía <strong>' + fmt(broma.energia_mcal,2,' Mcal/kg') + '</strong></span><span>Energía <strong>' + fmt(broma.energia_mj,2,' MJ/kg') + '</strong></span><span>Energía2 <strong>' + fmt(broma.energia2_mcal,2,' Mcal/kg') + '</strong></span><span>AFORO <strong>' + fmt(broma.aforo_ua_ha,2,' UA/ha') + '</strong></span></div></section>'
            + '<section style="border:1px solid #e2e8f0;border-radius:9px;padding:8px;background:#fff;font-size:10px;"><h4 style="font-size:11px;font-weight:700;color:#334155;margin:0 0 6px;"><i class="fas fa-chart-line" style="margin-right:5px;color:#64748b;" aria-hidden="true"></i>Variables avanzadas</h4><div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 8px;color:#475569;"><span>VI <strong>' + fmt(vars.vi,3) + '</strong></span><span>VARI <strong>' + fmt(vars.vari,3) + '</strong></span><span>GLI <strong>' + fmt(vars.gli,3) + '</strong></span><span>NGRDI <strong>' + fmt(vars.ngrdi,3) + '</strong></span><span>ExG <strong>' + fmt(vars.exg,3) + '</strong></span></div></section></div>'
            + '<details style="margin-top:8px;border:1px solid #e2e8f0;border-radius:9px;background:#fff;"><summary style="cursor:pointer;padding:7px 9px;font-size:10px;font-weight:700;color:#334155;">Nutrientes estimados (' + (Array.isArray(stats.nutrients) ? stats.nutrients.length : 0) + ')</summary><div class="grid grid-cols-1 gap-1.5 px-2 pb-2 text-[10px] sm:grid-cols-2">' + (nutrients || 'Sin nutrientes calculados.') + '</div></details>'
            + (balances[index] ? '<details style="margin-top:8px;border:1px solid #d1fae5;border-radius:9px;background:#ecfdf5;"><summary style="cursor:pointer;padding:7px 9px;font-size:10px;font-weight:700;color:#047857;">Ver balance de minerales</summary><div style="padding:8px;">' + balanceTable(balances[index], entry, objective) + '</div></details>' : '')
            + '</div>';
          const badgeStyle = objectiveEntry
            ? 'background:#fffbeb;border:1px solid #fde68a;color:#92400e;'
            : 'background:#f8fafc;border:1px solid #e2e8f0;color:#475569;';
          return '<article style="min-width:0;overflow:hidden;border:' + (objectiveEntry ? '2px solid #d6a329' : '1px solid #dbe3ec') + ';border-radius:14px;background:#fff;box-shadow:0 4px 14px rgba(15,23,42,.08);">'
            + '<header style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 12px;background:#fff;color:#0f172a;border-bottom:1px solid #eef2f7;"><h2 style="margin:0;font-size:14px;font-weight:700;">' + escapeHtml(entry.name || ('Lote ' + (index + 1))) + '</h2><span style="white-space:nowrap;border-radius:999px;padding:4px 8px;font-size:9px;font-weight:800;letter-spacing:.02em;' + badgeStyle + '">' + badge + '</span></header>'
            + analysis + '</article>';
        }).join('');
        comparisonContent.insertAdjacentHTML('beforeend', '<div><div class="mb-3 flex flex-wrap items-end justify-between gap-2"><div><h2 class="text-sm font-semibold">Comparación lado a lado</h2><p class="mt-0.5 text-[11px] text-gray-500">Cada columna corresponde a un lote y su análisis.</p></div><span class="text-[11px] text-gray-500">' + entries.length + ' lotes</span></div><div class="grid grid-cols-1 gap-3 lg:grid-cols-2" style="align-items:start;">' + detailPanels + '</div></div>');
      }catch(error){
        console.error('Error preparando comparación de lotes', error);
        comparisonContent.innerHTML = '<div class="border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">No se pudo calcular la comparación de los lotes seleccionados.</div>';
      }
    }
    if(comparisonButton){ comparisonButton.addEventListener("click", openLotComparison); }
    if(topComparisonButton){ topComparisonButton.addEventListener("click", openLotComparison); }
    if(comparisonClose){ comparisonClose.addEventListener("click", closeLotComparison); }
    if(comparisonModal){ comparisonModal.querySelectorAll("[data-close-lot-comparison]").forEach(node => node.addEventListener("click", closeLotComparison)); }
    document.addEventListener("keydown", event => { if(event.key === "Escape" && comparisonModal && !comparisonModal.classList.contains("hidden")){ closeLotComparison(); } });

    function renderPreview(){
      if(!section || !hint || !cards){ return; }
      syncObjectiveOptions();
      const entries = getPreviewEntries();
      const comparableEntries = getComparableLotEntries();
      const objective = getSelectedObjective();
      if(comparisonButton){
        const comparableCount = Math.min(comparableEntries.length, 4);
        const canCompare = comparableCount >= 2;
        comparisonButton.disabled = false;
        comparisonButton.title = canCompare ? "Abrir comparación de lotes" : "Pulsa para ver qué falta para comparar";
        const labelNode = comparisonButton.querySelector("span");
        if(labelNode){ labelNode.textContent = comparableCount >= 2 ? "Comparar " + comparableCount + " lotes" : "Comparar lotes (mínimo 2)"; }
        const availability = document.getElementById("lotComparisonAvailability");
        if(availability){ availability.textContent = canCompare ? "Comparación disponible para los polígonos calculados." : "Dibuja o carga al menos dos polígonos para compararlos."; }
        if(topComparisonButton){
          topComparisonButton.disabled = false;
          topComparisonButton.title = canCompare ? "Comparar lotes contra el objetivo de referencia" : comparisonButton.title;
          topComparisonButton.style.backgroundColor = canCompare ? "#4338ca" : "#64748b";
          topComparisonButton.style.color = "#ffffff";
          topComparisonButton.style.opacity = "1";
        }
      }      const label = select && select.selectedIndex >= 0 ? (select.options[select.selectedIndex].textContent || '').trim() : '';
      const signature = entries.map(entry => [entry.id, entry.name, !!entry.areaStats].join(':')).join('|') + '::' + (select ? select.value : '');
      if(signature === lastSignature){ return; }
      lastSignature = signature;
      if(!entries.length){ hint.textContent = 'Dibuja un polígono para ver aquí la comparación previa.'; cards.innerHTML = ''; return; }
      if(!objective){ hint.textContent = 'Selecciona un objetivo para completar la tabla de comparación.'; cards.innerHTML = ''; return; }
      hint.textContent = 'Comparación previa calculada con los datos del polígono y el objetivo seleccionado.';
      try{
        cards.innerHTML = entries.map(entry => renderEntry(entry, buildRows(entry.areaStats || {}, objective), label)).join('');
        renderBalances(entries, objective);
      }catch(err){
        console.error('Error renderizando vista previa nutricional', err);
        cards.innerHTML = '<div class="rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-700">No se pudo pintar la vista previa nutricional. Revisa los datos del polígono activo.</div>';
      }
    }
    if(select){ select.addEventListener('change', () => { balanceCache.clear(); lastSignature = ''; renderPreview(); }); }
    renderPreview();
    window.setInterval(renderPreview, 800);
  })();

  })();
  </script>
  <script src="/js/mineral-balance-modal.js?v=foliar-fixed-3-decimals-20260830" data-comparison-url="{{ url_for('agrovista.comparison_config') }}"></script>
{% endblock %}
