    if(el.editPolygonBtn){
      el.editPolygonBtn.addEventListener('click', async () => {
        const layer = activeLayerId !== null ? drawnItems.getLayer(activeLayerId) : null;
        if(!layer || !layer.editing){ return; }
        if(editingLayerId === activeLayerId){
          layer.editing.disable();
