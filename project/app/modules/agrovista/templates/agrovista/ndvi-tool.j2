    function balanceEntryMap(balance){
      const map = new Map();
      const entries = balance && Array.isArray(balance.entries) ? balance.entries : [];
      entries.forEach(item => map.set(normalizeName(item.name), item));
      return map;
    }
    function comparisonMetric(value, suffix){
      const number = Number(value);
      return Number.isFinite(number) ? formatNutrientValue(number) + (suffix || "") : "--";
    }
    const comparisonNutrients = [["n","N"],["p","P"],["k","K"],["ca","Ca"],["mg","Mg"],["s","S"],["cu","Cu"],["zn","Zn"],["mn","Mn"],["b","B"],["mo","Mo"],["fe","Fe"],["si","Si"]];
    function comparisonEntryMeta(entry){
      const stats=entry.areaStats||{}, lot=(foliarState.lots||[]).find(item=>Number(item.id)===Number(entry.linkedLotId));
      const farm=(foliarState.farms||[]).find(item=>Number(item.id)===Number(lot&&lot.farm_id));
      return {id:entry.linkedLotId||entry.id,date:stats.orthophoto_date||stats.analysis_date||stats.date||getOrthophotoDateLabel(),farm:stats.farm_name||(farm&&farm.name)||"",lot:(lot&&lot.name)||entry.name||"Lote"};
    }
    function comparisonEntryValues(entry){
      const values=new Map();
      ((entry.areaStats&&entry.areaStats.nutrients)||[]).forEach(item=>{const key=canonicalNutrientKey(item),value=Number(item.target_value);if(key){values.set(key,Number.isFinite(value)?value:null);}});
      return values;
    }
    function comparisonTableRow(entry,selected,objective){
      const meta=comparisonEntryMeta(entry),values=comparisonEntryValues(entry),id=String(entry.id).replace(/[^a-zA-Z0-9_-]/g,'');
      const css=objective?'bg-amber-50 ring-1 ring-inset ring-amber-300':(selected?'bg-emerald-100 ring-1 ring-inset ring-emerald-500':'cursor-pointer hover:bg-emerald-50');
      return '<tr '+(objective?'':'data-comparison-row="'+id+'"')+' class="'+css+'"><td class="px-2 py-1.5 text-center">'+escapeHtml(meta.id)+'</td><td class="px-2 py-1.5 text-center">'+escapeHtml(meta.date)+'</td><td class="px-2 py-1.5">'+escapeHtml(meta.farm)+'</td><td class="px-2 py-1.5 font-semibold">'+escapeHtml(meta.lot)+'</td>'+comparisonNutrients.map(item=>'<td class="px-2 py-1.5 text-center">'+comparisonMetric(values.get(item[0]))+'</td>').join('')+'</tr>';
    }
    function comparisonTable(title,rows,objective){
      const head='<tr><th class="px-2 py-2">ID</th><th class="px-2 py-2">Fecha</th><th class="px-2 py-2 text-left">Finca</th><th class="px-2 py-2 text-left">Potrero</th>'+comparisonNutrients.map(item=>'<th class="px-2 py-2">'+item[1]+'</th>').join('')+'</tr>';
      return '<section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm"><h3 class="border-b px-3 py-2 text-xs font-bold uppercase tracking-wider '+(objective?'text-amber-700':'text-emerald-700')+'">'+title+'</h3><div class="max-h-[190px] overflow-auto"><table class="w-full min-w-[1120px] border-collapse text-[11px]"><thead class="sticky top-0 z-10 bg-gray-100 text-gray-600">'+head+'</thead><tbody class="divide-y">'+rows+'</tbody></table></div></section>';
    }
    function comparisonObjective(entry){
      const stats=entry.areaStats||{},broma=stats.bromatologia||{};
      return {crop_name:comparisonEntryMeta(entry).lot,protein:stats.protein||stats.protein_average,target_value:broma.aforo_ua_ha||broma.aforo||stats.yield_estimate||stats.aforo_ua_ha||stats.aforo,nutrient_targets:(stats.nutrients||[]).map(item=>({nutrient_name:item.nutrient_name,nutrient_symbol:item.nutrient_symbol,nutrient_unit:item.nutrient_unit,target_value:item.target_value}))};
    }
    async function openLotComparisonTables(){
