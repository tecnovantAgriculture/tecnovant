WEBODM_URL=http://IP_PUBLICA_DE_GOOGLE:8000
WEBODM_PUBLIC_URL=http://IP_PUBLICA_DE_GOOGLE:8000
WEBODM_USERNAME=Tecnovan
WEBODM_PASSWORD=CAMBIAR_PASSWORD_WEBODM
WEBODM_PROJECT_NAME=Tecnovan
WEBODM_REQUEST_TIMEOUT_SECONDS=60
WEBODM_UPLOAD_TIMEOUT_SECONDS=7200
WEBODM_READY_TIMEOUT_SECONDS=900
WEBODM_STATUS_POLL_SECONDS=60

# Perfil por defecto para entregables finales de alta calidad.
WEBODM_PROCESSING_PROFILE=max_2d
WEBODM_FEATURE_QUALITY=high
WEBODM_PC_QUALITY=high
WEBODM_MATCHER_NEIGHBORS=24
WEBODM_MATCHER_ORDER=24
WEBODM_MIN_NUM_FEATURES=25000
WEBODM_ORTHOPHOTO_RESOLUTION=2.7

# Encendido/apagado automatico de la VM grande de WebODM.
WEBODM_AUTOSTART=true
WEBODM_AUTOSTOP=true
GCP_PROJECT_ID=PROYECTO_DONDE_ESTA_LA_VM
GCP_ZONE=us-central1-b
GCP_WEBODM_INSTANCE=webodm-ortofotos
# En Railway, pegar el JSON completo de la cuenta de servicio:
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Para Docker/local tambien se puede montar un archivo:
# GCP_SERVICE_ACCOUNT_FILE=/app/secrets/gcp-vm-manager.json
GCP_OPERATION_TIMEOUT_SECONDS=600

# Selector de imagenes desde Google Drive en el modal de ortofotos.
# Habilitar Google Picker API y Google Drive API en Google Cloud.
GOOGLE_DRIVE_PICKER_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_DRIVE_PICKER_API_KEY=AIza...
GOOGLE_DRIVE_PICKER_APP_ID=000000000000

# Solo usar si la calidad queda floja y queremos limitar la imagen original antes de WebODM.
# WEBODM_RESIZE_TO=4000
